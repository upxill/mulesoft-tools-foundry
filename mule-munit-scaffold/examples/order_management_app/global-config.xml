<?xml version="1.0" encoding="UTF-8"?>
<!--
  Global connector configurations for the order-management example app.

  XML shape confirmed 2026-09-13 against:
    - https://docs.mulesoft.com/http-connector/latest/http-connector-xml-reference
    - https://docs.mulesoft.com/db-connector/latest/database-connector-connection
  (Same references already verified accurate by the sibling project
  mule-flow-doctor, see its README.md "Mule 4 XML schema research"
  section, reused here as a confirmed-correct starting point rather
  than re-deriving from scratch.)
-->
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:db="http://www.mulesoft.org/schema/mule/db"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd">

    <!-- Inbound listener used by orders-flow.xml -->
    <http:listener-config name="orders-api-listener-config" basePath="/api">
        <http:listener-connection host="0.0.0.0" port="8081"/>
    </http:listener-config>

    <!-- Outbound: inventory service (checked before accepting an order) -->
    <http:request-config name="inventoryServiceConfig" basePath="/inventory">
        <http:request-connection host="inventory.internal.example.com" port="443" protocol="HTTPS"/>
    </http:request-config>

    <!-- Outbound: payment service (charged from the billing flow) -->
    <http:request-config name="paymentServiceConfig" basePath="/payments">
        <http:request-connection host="payments.internal.example.com" port="443" protocol="HTTPS"/>
    </http:request-config>

    <!-- Outbound: orders database, used by both flows -->
    <db:config name="ordersDbConfig">
        <db:my-sql-connection host="orders-db.internal.example.com" port="3306"
                               user="orders_svc" password="${secure::db.password}"/>
    </db:config>

</mule>
