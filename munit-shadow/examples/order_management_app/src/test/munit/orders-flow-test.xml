<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
    xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
    xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
    xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

  <munit:config name="orders-flow-test-suite" minMuleVersion="4.4.0"/>

    <munit:test name="test-orders-process-flow" description="Verifies orders-process-flow checks inventory and passes the quantity through untouched">
    <munit:behavior>
        <!-- Srinivas: mocking the inventory check so this test never hits the real staging endpoint -->
          <munit-tools:mock-when processor="http:request" doc:name="Mock inventory check">
            <munit-tools:with-attributes>
                <munit-tools:with-attribute attributeName="config-ref" whereValue="#['inventoryServiceConfig']"/>
            </munit-tools:with-attributes>
              <munit-tools:then-return>
                <munit-tools:payload value="#[{ sku: 'SKU-1', quantityAvailable: 42 }]" mediaType="application/json"/>
            </munit-tools:then-return>
        </munit-tools:mock-when>
    </munit:behavior>
        <munit:execution>
      <munit:set-event>
                <munit:payload value="#[{ sku: 'SKU-1' }]" mediaType="application/json"/>
      </munit:set-event>
      <flow-ref name="orders-process-flow" doc:name="Call orders-process-flow"/>
        </munit:execution>
    <munit:validation>
        <!-- custom assertion (not a placeholder): the mocked quantityAvailable must flow through as-is -->
      <munit-tools:assert-that expression="#[payload.quantityAvailable]" is="#[MunitTools::equalTo(42)]"/>
    </munit:validation>
  </munit:test>

</mule>
